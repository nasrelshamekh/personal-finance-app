# Copy to .env at the repo root. The server reads this file; Prisma reads DATABASE_URL from it too.

# Postgres — matches docker-compose.yml.
# Port 5433 on the host, because a locally-installed PostgreSQL may already own 5432.
DATABASE_URL="postgresql://ledger:ledger@localhost:5433/ledger?schema=public"

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API.
# Add your LAN address here to use the app from your phone, e.g. http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173

# FX
# Manual rates are the default and the app is fully functional with no network at all.
# Flip ratesApiEnabled in Settings (not here) to allow the API provider.
FX_API_BASE_URL=https://open.er-api.com/v6/latest
